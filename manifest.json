{
  "manifest_version": 3,
  "name": "Social Media Scroll Hardener",
  "version": "1.1",
  "description": "Throttles scroll distance on select platforms.",
  "permissions": [],
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*",
        "https://*.tiktok.com/*",
        "https://*.instagram.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
